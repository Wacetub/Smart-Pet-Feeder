.container {
  padding: 20rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

/* 状态卡片样式 */
.status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.connection-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
}

.connected {
  background: #e8f7ed;
  color: #07c160;
}

.disconnected {
  background: #fef0f0;
  color: #fa5151;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.status-item {
  text-align: center;
}

.label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 物料状态样式 */
.material-status {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.material-item {
  margin-bottom: 24rpx;
}

.material-item:last-child {
  margin-bottom: 0;
}

.progress-bar {
  height: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress {
  height: 100%;
  background: #07c160;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.material-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 今日统计样式 */
.today-stats {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stats-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-content {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stats-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.stats-value {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

/* 历史记录样式 */
.history-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.clear-btn {
  background: #fa5151;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.clear-btn:active {
  opacity: 0.8;
}

.history-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.time {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.type {
  font-size: 24rpx;
  color: #999;
}

.amount {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.date-range-picker {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.picker-item text {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
} 