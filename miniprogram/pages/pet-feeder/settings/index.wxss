.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-header {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.section-header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  padding: 20rpx;
}

/* 设备信息样式 */
.input-item {
  margin-bottom: 20rpx;
}

.input-item .label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input-item .input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
}

.info-item .value.connected {
  color: #07c160;
}

.info-item .value.disconnected {
  color: #ff4d4f;
}

/* 开关项样式 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.switch-item .label {
  font-size: 28rpx;
  color: #666;
}

/* 投食时间样式 */
.feed-times {
  margin-top: 20rpx;
}

.feed-time-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}

.time-picker,
.amount-picker {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #fff;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.delete-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.add-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 滑块样式 */
.slider-item {
  margin-bottom: 30rpx;
}

.slider-item .label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

/* 重置按钮样式 */
.reset-section {
  padding: 40rpx 20rpx;
}

.reset-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
} 